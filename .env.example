# Required for mutating dashboard/API routes in deployed environments.
POLYCOPY_API_TOKEN=replace-with-a-long-random-secret

# Comma-separated permitted browser origins. Use your deployed URL.
POLYCOPY_CORS_ORIGINS=https://your-service.onrender.com

# Set this to the mount path of a persistent disk in production.
POLYCOPY_DATA_DIR=/var/data
